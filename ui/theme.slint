// Tokens Material 3 (esquema base) + estado compartido con Rust.

export struct VideoRow {
    title: string,
    meta: string,
    thumb: image,
    has-thumb: bool,
    selected: bool,
}

export struct QueueRow {
    id: int,
    title: string,
    status: string,
    detail: string,
    pct: float,
    thumb: image,
    has-thumb: bool,
    paused: bool,
    busy: bool,
    can-pause: bool,
    can-up: bool,
    can-down: bool,
}

export struct HistoryRow {
    id: string,
    title: string,
    meta: string,
    error: string,
    can-edit: bool,
    // 0 = completado, 1 = fallido, 2 = omitido
    kind: int,
    thumb: image,
    has-thumb: bool,
}

export struct ProfileRow {
    id: string,
    name: string,
    desc: string,
    audio: bool,
    builtin: bool,
    active: bool,
}

export global Backend {
    in-out property <int> page: 0;
    in-out property <bool> dark: true;

    // Buscar
    in-out property <string> search-query;
    in-out property <int> search-count-idx: 1;
    in property <bool> search-busy;
    in property <string> search-error;
    in property <[VideoRow]> search-rows;
    in property <int> search-selected;

    // URL
    in-out property <string> url-text;
    in-out property <string> bulk-text;
    in-out property <int> url-mode: 0;
    in property <bool> url-busy;
    in property <string> url-error;
    in property <string> url-title;
    in property <[VideoRow]> url-rows;
    in property <int> url-selected;
    in property <string> skipped-summary;

    // Perfil y carpeta de destino
    in property <[string]> profile-names;
    in-out property <int> profile-index: 0;
    in property <string> profile-desc;
    in property <string> dest-dir;

    // Descargas
    in property <[QueueRow]> queue-rows;
    in property <[HistoryRow]> history-rows;
    in property <int> history-total;
    in-out property <string> hist-query;
    in-out property <int> hist-filter: 0;

    // Perfiles
    in property <[ProfileRow]> profile-rows;

    // Ajustes
    in-out property <int> cookies-mode: 0;
    in-out property <string> cookies-file;
    in-out property <int> cookies-browser-idx: 0;
    in-out property <string> proxy-url;
    in-out property <int> playlist-limit: 300;
    in-out property <int> rate-idx: 0;
    in-out property <int> conc-idx: 1;
    in-out property <int> cautious-idx: 1;
    in-out property <bool> sponsorblock;
    in-out property <bool> normalize;
    in-out property <bool> embed;
    in-out property <bool> subs;
    in-out property <int> subs-lang-idx: 2;
    in-out property <bool> auto-update: true;

    // Herramientas
    in property <string> ytdlp-version;
    in property <string> ffmpeg-version;
    in property <string> tools-status;
    in property <bool> tools-busy;
    in property <float> tools-progress;

    // General / organizacion
    in-out property <bool> clipboard-watch: true;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> notifications: true;
    in-out property <int> folder-idx: 0;
    in-out property <string> name-template: "{title}";
    in-out property <int> lang-idx: 0;
    in-out property <bool> compact-pref: false;
    in-out property <bool> narrow: false;

    // Recorte
    in-out property <string> range-from;
    in-out property <string> range-to;

    // Editor de etiquetas
    in-out property <bool> tag-dialog: false;
    in-out property <string> tag-title;
    in-out property <string> tag-artist;
    in-out property <string> tag-album;
    in property <string> tag-cover;
    in property <bool> tag-busy;

    in property <string> ext-title;

    // Actualizacion de la app
    in property <string> app-version;
    in property <string> app-update-status;
    in property <bool> app-update-available;
    in property <bool> app-update-busy;

    // Recorte por video
    in-out property <bool> trim-dialog: false;
    in property <string> trim-title;
    in property <string> trim-duration;
    in property <image> trim-thumb;
    in property <bool> trim-has-thumb;
    in-out property <string> trim-from;
    in-out property <string> trim-to;

    // Avisos y dialogos
    in property <string> toast-text;
    in property <bool> toast-visible;
    in-out property <bool> ext-dialog;
    in property <string> ext-url;
    in-out property <bool> profile-dialog;

    callback search();
    callback extract-url();
    callback toggle-select(int, int);
    callback select-all(int, bool);
    callback clear-list(int);
    callback remove-unselected(int);
    callback download(int);

    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback drag-move(int, float);
    callback open-queue-folder(int);
    callback clear-queue();

    callback retry(string);
    callback open-folder(string);
    callback clear-history();
    callback history-changed();

    callback choose-folder();
    callback profile-changed();
    callback profile-activate(string);
    callback profile-delete(string);
    callback profile-create(string, int, int, int, int);

    callback settings-changed();
    callback check-tools();
    callback browse-cookies();
    callback open-logs();
    callback ext-choice(int);
    callback toggle-dark();
    callback check-app-update();
    callback install-app-update();
    callback preview(int, int, bool);
    callback trim-open(int, int);
    callback trim-apply();
    callback trim-clear();
    callback trim-preview(bool);
    callback trim-frame(bool);
    callback url-mode-changed();
    callback edit-tags(string);
    callback tag-pick-cover();
    callback tag-save();
}

export global Lay {
    out property <bool> compact: Backend.compact-pref || Backend.narrow;
    out property <length> pad: compact ? 16px : 32px;
    out property <length> nav: compact ? 72px : 96px;
}

export global M3 {
    out property <bool> dark: Backend.dark;

    out property <color> primary: dark ? #9ECAFF : #0061A4;
    out property <color> on-primary: dark ? #003258 : #FFFFFF;
    out property <color> primary-container: dark ? #00497D : #D1E4FF;
    out property <color> on-primary-container: dark ? #D1E4FF : #001D36;
    out property <color> secondary-container: dark ? #3B4858 : #D7E3F8;
    out property <color> on-secondary-container: dark ? #D7E3F8 : #101C2B;
    out property <color> surface: dark ? #101418 : #F8F9FF;
    out property <color> surface-low: dark ? #181C20 : #F2F3F9;
    out property <color> surface-container: dark ? #1C2024 : #ECEEF4;
    out property <color> surface-high: dark ? #262A2F : #E6E8EE;
    out property <color> surface-highest: dark ? #31353A : #E0E2E8;
    out property <color> on-surface: dark ? #E0E2E8 : #191C20;
    out property <color> on-surface-variant: dark ? #C3C7CF : #43474E;
    out property <color> outline: dark ? #8D9199 : #73777F;
    out property <color> outline-variant: dark ? #43474E : #C3C7CF;
    out property <color> error: dark ? #FFB4AB : #BA1A1A;
    out property <color> error-container: dark ? #93000A : #FFDAD6;
    out property <color> on-error-container: dark ? #FFDAD6 : #410002;
    out property <color> success: dark ? #7DDB9A : #1B7F3B;
    out property <color> inverse-surface: dark ? #E0E2E8 : #2E3135;
    out property <color> inverse-on-surface: dark ? #2E3135 : #EFF0F7;
    out property <color> scrim: #000000;
}

